{
    "name": "laraditz/filament-jaga",
    "description": "FilamentPHP v5 plugin for managing roles and permissions with laraditz/jaga",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "laraditz/jaga": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Laraditz\\FilamentJaga\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraditz\\FilamentJaga\\Tests\\": "tests/",
            "Laraditz\\FilamentJaga\\Tests\\Models\\": "tests/Models/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Laraditz\\FilamentJaga\\FilamentJagaServiceProvider"]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../jaga",
            "canonical": false,
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
